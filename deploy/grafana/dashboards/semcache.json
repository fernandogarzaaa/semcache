{
 "uid": "semcache",
 "title": "semcache",
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "type": "stat",
   "title": "Hit rate (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(semcache_requests_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(semcache_requests_total[5m])), 1e-9)"
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Estimated saved (USD, total)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(semcache_saved_usd_total)"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Entries / capacity",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(semcache_entries) / sum(semcache_capacity_entries)"
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Upstream spend (USD, total)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(semcache_upstream_usd_total)"
    }
   ],
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Hit rate by model",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(semcache_requests_total{result=\"hit\"}[1m])) / clamp_min(sum by (model) (rate(semcache_requests_total[1m])), 1e-9)",
     "legendFormat": "{{model}}"
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Cumulative cost saved (USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(semcache_saved_usd_total)",
     "legendFormat": "saved"
    },
    {
     "refId": "B",
     "expr": "sum(semcache_upstream_usd_total)",
     "legendFormat": "spent upstream"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Latency: cached vs uncached",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, result) (rate(semcache_request_seconds_bucket[1m])))",
     "legendFormat": "p50 {{result}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, result) (rate(semcache_request_seconds_bucket[1m])))",
     "legendFormat": "p95 {{result}}"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, result) (rate(semcache_request_seconds_bucket[1m])))",
     "legendFormat": "p99 {{result}}"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Similarity of best match (p50) by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, outcome) (rate(semcache_similarity_bucket[5m])))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Evictions by reason",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(semcache_evictions_total[5m]))",
     "legendFormat": "{{reason}}"
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Thresholds per task type and hourly hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "semcache_threshold",
     "legendFormat": "{{task}}"
    },
    {
     "refId": "B",
     "expr": "sum(increase(semcache_requests_total{result=\"hit\"}[1h])) / clamp_min(sum(increase(semcache_requests_total[1h])), 1)",
     "legendFormat": "hourly hit rate"
    }
   ],
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Upstream errors (not cached)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(semcache_upstream_errors_total[5m]))",
     "legendFormat": "{{reason}}"
    }
   ],
   "id": 11
  }
 ],
 "tags": [
  "semcache"
 ]
}